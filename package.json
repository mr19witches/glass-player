{
  "name": "glass-player",
  "version": "1.0.0",
  "description": "Liquid glass lyrics player for Spotify",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.glassplayer",
    "productName": "Glass Player",
    "files": ["main.js", "preload.js", "index.html"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "Glass Player.exe" }
  }
}
